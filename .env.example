# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=medisentinel

# Passwords of the three login roles on YOUR machine (set by running sql/roles.sql)
MS_DOCTOR_PASSWORD=
MS_PHARMACIST_PASSWORD=
MS_ADMIN_PASSWORD=

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=medisentinel
